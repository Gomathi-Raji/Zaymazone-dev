# ══════════════════════════════════════════════════════════════════════════════
# Zaymazone Frontend — Environment Variables Template
# Copy this file to .env and fill in the values before running `npm run dev`.
# ══════════════════════════════════════════════════════════════════════════════

# Backend API base URL or origin
VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_URL=http://localhost:4000

# Public site metadata
VITE_COMPANY_NAME=Zaymazone
VITE_SITE_URL=https://zaymazone.com
VITE_HELP_URL=https://zaymazone.com/help
VITE_PROMO_BAR_TEXT=Free shipping on orders over 999 INR - Handcrafted with love
VITE_FREE_SHIPPING_THRESHOLD=999

# Support/contact info
VITE_SUPPORT_EMAIL=support@zaymazone.com
VITE_SUPPORT_PHONE=+91 98765 43210
VITE_SUPPORT_ADDRESS=123 Craft Street\nDelhi, India 110001
VITE_SUPPORT_HOURS=Mon-Fri 9AM-6PM IST

# Default emails for UI fallbacks
VITE_ADMIN_EMAIL=admin@zaymazone.com
VITE_ARTISAN_EMAIL=artisan@zaymazone.com
VITE_CUSTOMER_EMAIL=customer@zaymazone.com

# Firebase Web SDK config
# (Firebase Console → Project Settings → Your Apps → Web App → SDK Config)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
