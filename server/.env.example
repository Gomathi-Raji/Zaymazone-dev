# ============================================
# SERVER ENVIRONMENT VARIABLES (.env)
# ============================================
# Copy this file to server/.env and fill in your values
# IMPORTANT: Never commit .env file with real secrets!

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
PORT=4000

# ============================================
# Database Configuration
# ============================================
# MongoDB connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=dbname
# Or local: mongodb://localhost:27017/zaymazone
MONGODB_URI=mongodb://localhost:27017/zaymazone

# ============================================
# JWT Authentication
# ============================================
# Generate a strong random secret (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars_here

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# PRODUCTION: Only include your actual domain
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ============================================
# Firebase Configuration (Backend)
# ============================================
# Firebase service account credentials JSON (see setup guide)
# In production, use environment variable or secrets manager
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_KEY=path_to_service_account_key.json

# ============================================
# Payment Gateway Configuration
# ============================================
# Paytm Payment Gateway
PAYTM_MERCHANT_ID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=your_paytm_website_name
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
# Set to true to use mock mode (for testing without live credentials)
PAYTM_MOCK_MODE=true

# Zoho Payments (if using)
ZOHO_AUTH_TOKEN=your_zoho_auth_token
ZOHO_MERCHANT_ID=your_zoho_merchant_id

# ============================================
# Email Configuration (Optional)
# ============================================
# For sending emails to users/artisans
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@zaymazone.com

# ============================================
# Firebase Frontend Credentials (Client-side)
# ============================================
# These can be public (they're meant for frontend)
# But keep them organized here for reference
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ============================================
# Logging & Monitoring (Optional)
# ============================================
# Sentry error tracking
SENTRY_DSN=your_sentry_dsn_url

# LogRocket session replay
LOGROCKET_ID=your_logrocket_id

# ============================================
# Security Settings
# ============================================
# Session timeout in minutes
SESSION_TIMEOUT=30

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Rate limiting requests per minute
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable features for gradual rollout
FEATURE_PAYMENT_ENABLED=true
FEATURE_ARTISAN_APPROVAL_ENABLED=true
FEATURE_REVIEWS_ENABLED=true
