# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Use this for production deployment
# Set these via your hosting platform's secrets manager:
# - Vercel: Environment Variables in Project Settings
# - Render: Environment in Service Settings
# - AWS: Secrets Manager
# - Azure: Key Vault
# - Heroku: Config Vars

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
PORT=4000

# ============================================
# Database Configuration (Production)
# ============================================
# Use MongoDB Atlas connection string with:
# - Strong username/password
# - IP whitelist enabled
# - Connection string from Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=zaymazone&retryWrites=true&w=majority

# ============================================
# JWT Authentication
# ============================================
# CRITICAL: Generate strong random secret (minimum 64 characters)
# $ node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_64_chars_minimum_change_regularly

# ============================================
# CORS Configuration (Production)
# ============================================
# PRODUCTION: Restrict to your actual domain only
# DO NOT use localhost or wildcard (*)
CORS_ORIGIN=https://zaymazone.com,https://www.zaymazone.com,https://app.zaymazone.com

# ============================================
# Firebase Configuration (Production)
# ============================================
# Use your production Firebase project
FIREBASE_PROJECT_ID=zaymazone-prod-firebase-id
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/firebase-adminsdk-prod.json

# ============================================
# Payment Gateway Configuration (Production)
# ============================================
# Paytm Payment Gateway - Production Credentials
PAYTM_MERCHANT_ID=your_production_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_production_paytm_merchant_key
PAYTM_WEBSITE=ZAYMAZONE
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
# CRITICAL: Set to false in production (use real payment processing)
PAYTM_MOCK_MODE=false

# Zoho Payments - Production
ZOHO_AUTH_TOKEN=your_production_zoho_token
ZOHO_MERCHANT_ID=your_production_zoho_merchant_id

# ============================================
# Email Configuration (Production)
# ============================================
# Use dedicated email service like SendGrid, Mailgun, or AWS SES
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@zaymazone.com
SMTP_FROM_NAME=Zaymazone

# ============================================
# Frontend Credentials
# ============================================
# Production Firebase project credentials
VITE_FIREBASE_API_KEY=your_prod_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=zaymazone-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zaymazone-prod-firebase-id
VITE_FIREBASE_STORAGE_BUCKET=zaymazone-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_prod_messaging_sender_id
VITE_FIREBASE_APP_ID=your_prod_firebase_app_id

# ============================================
# Monitoring & Error Tracking
# ============================================
# Sentry for error tracking
SENTRY_DSN=your_sentry_production_dsn_url

# LogRocket for session replay
LOGROCKET_ID=your_logrocket_production_id

# New Relic APM monitoring (optional)
# NEW_RELIC_LICENSE_KEY=your_new_relic_key

# ============================================
# Security Settings
# ============================================
SESSION_TIMEOUT=30
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# API Configuration
# ============================================
# Production API URL
VITE_API_BASE_URL=https://api.zaymazone.com/api
VITE_API_URL=https://api.zaymazone.com/api

# ============================================
# Logging
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Feature Flags
# ============================================
FEATURE_PAYMENT_ENABLED=true
FEATURE_ARTISAN_APPROVAL_ENABLED=true
FEATURE_REVIEWS_ENABLED=true
